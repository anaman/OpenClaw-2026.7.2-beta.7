# /home/[USER]/.config/systemd/user/openclaw-wa-healthcheck.timer
[Unit]
Description=Run OpenClaw WhatsApp health check every 50 seconds
# Only start checking once the gateway is up
After=openclaw-gateway.service
Wants=openclaw-wa-healthcheck.service

[Timer]
OnBootSec=60
OnUnitActiveSec=50
AccuracySec=5s
Unit=openclaw-wa-healthcheck.service

[Install]
WantedBy=timers.target
[hostname]::~$ systemctl --user cat openclaw-wa-healthcheck.service
# /home/[USER]/.config/systemd/user/openclaw-wa-healthcheck.service
[Unit]
Description=OpenClaw WhatsApp bridge health-check service
Wants=openclaw-wa-healthcheck.timer

[Service]
Type=oneshot
ExecStart=/home/[USER]/.local/bin/openclaw-wa-healthcheck.sh
# If a check hangs, kill it so the next tick isn't blocked
TimeoutStartSec=40
# Environment so the script can reach the gateway + systemd
Environment=HOME=/home/[USER]
Environment=PATH=/usr/bin:/usr/local/bin:/bin:/home/[USER]/.npm-global/bin

[Install]
WantedBy=default.target
