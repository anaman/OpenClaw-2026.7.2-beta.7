#!/usr/bin/env bash
# openclaw-wa-healthcheck.sh
# Self-heal the OpenClaw WhatsApp bridge: every 50s (via systemd timer) check
# that WhatsApp is actually running; if the account is stopped/not-running,
# restart the gateway so the bridge re-establishes in-process.
#
# Why a gateway restart: the WhatsApp transport runs inside the gateway node
# process (no standalone binary). If the account shows "stopped/not-running"
# while the gateway is otherwise "healthy", the only reliable recovery is to
# restart the gateway, which re-initializes all channel transports.
#
# Log: journalctl --user -u openclaw-wa-healthcheck.service
set -u

BIN="/home/[USER]/.npm-global/bin/openclaw"
LOG_TAG="wa-healthcheck"
STATE_FILE="/tmp/openclaw-wa-healthcheck.stamp"

# ---- guard: avoid running two checks at once ----
exec 9>"${STATE_FILE}.lock"
if ! flock -n 9; then
  exit 0  # another instance is running; skip
fi

# ---- gather status (exit code is always 0; we parse text) ----
STATUS="$(${BIN} channels status --probe 2>&1)"
RC=$?
if [ ${RC} -ne 0 ]; then
  logger -t "${LOG_TAG}" "channels status failed (rc=${RC}); assuming bridge down, will restart gateway"
  RESTART=1
else
  RESTART=0
  # Any WhatsApp account health:not-running or state:stopped => bridge is down
  if echo "${STATUS}" | grep -qi "whatsapp" && \
     ( echo "${STATUS}" | grep -qiE "whatsapp .*health:not-running|whatsapp .*stopped" ); then
    RESTART=1
  elif ! echo "${STATUS}" | grep -qi "whatsapp"; then
    # WhatsApp not present at all => channel failed to load entirely
    RESTART=1
  fi
fi

if [ "${RESTART}" -eq 1 ]; then
  logger -t "${LOG_TAG}" "WhatsApp bridge down; restarting openclaw-gateway"
  systemctl --user restart openclaw-gateway
  date +%s > "${STATE_FILE}"
else
  logger -t "${LOG_TAG}" "WhatsApp healthy; no action"
fi

flock -u 9
exit 0
